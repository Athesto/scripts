#!/usr/bin/env bash
set -euo pipefail # ExitOnError | UnsetError | PipelineFail

#------------------------------------------------------------------------------
#  HELP
#------------------------------------------------------------------------------

VERSION="2.1.0"
PROGRAM=$(basename "$0")
HELP=$(cat <<EOF
NAME
    ${PROGRAM} - track public IP address changes

DESCRIPTION
    Shows the current public IP address and keeps a history
    whenever it changes.

COMMANDS
    current
        shows the current public IP address

    update
        checks the current public IP and logs it if it changed

    log
        shows the public IP history

OPTIONS
    --help
        shows this help

    --version
        shows version

EXAMPLES
    Show the current public IP:
        ${PROGRAM}

    Explicitly show the current public IP:
        ${PROGRAM} current

    Update the public IP history:
        ${PROGRAM} update

    Show the public IP history:
        ${PROGRAM} log

AUTHOR
    athesto - athesto.github.io
EOF
)

[[ "$*" =~ --help ]] && printf "%s\n" "${HELP}" && exit 0
[[ "${1:-}" == --version ]] && echo "${PROGRAM} ${VERSION}" && exit 0

#------------------------------------------------------------------------------
#  CONFIG
#------------------------------------------------------------------------------

LOG="${HOME}/.local/share/public-ip.log"

#------------------------------------------------------------------------------
#  FUNCTIONS
#------------------------------------------------------------------------------

get_public_ip() {
    curl -fsS https://ifconfig.io/ip
}

update_public_ip() {
    mkdir -p "$(dirname "$LOG")"

    local current_ip
    local last_ip

    current_ip="$(get_public_ip)"
    last_ip="$(tail -n 1 "$LOG" 2>/dev/null | awk '{print $2}' || true)"

    if [[ "$current_ip" != "$last_ip" ]]; then
        printf '%s %s\n' \
            "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
            "$current_ip" >> "$LOG"

        printf 'Public IP changed: %s\n' "$current_ip"
    fi
}

show_log() {
    if [[ -f "$LOG" ]]; then
        cat "$LOG"
    else
        printf 'No public IP history yet.\n'
    fi
}

#------------------------------------------------------------------------------
#  MAIN
#------------------------------------------------------------------------------

case "${1:-current}" in
    current)
        get_public_ip
        ;;

    update)
        update_public_ip
        ;;

    log)
        show_log
        ;;

    *)
        printf 'Unknown command: %s\n' "$1" >&2
        printf 'Try "%s --help" for more information.\n' "${PROGRAM}" >&2
        exit 1
        ;;
esac