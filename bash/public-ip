#!/usr/bin/env bash
set -euo pipefail # ExitOnError | UnsetError | PipelineFail

#------------------------------------------------------------------------------
#  METADATA
#------------------------------------------------------------------------------

VERSION="2.2.0"
PROGRAM=$(basename "$0")

HELP=$(cat <<EOF
Usage: ${PROGRAM} [OPTION | COMMAND]

Track public IP address changes.

Commands:
  current       Show the current public IP address (default)
  update        Log the public IP if it changed
  log           Show the public IP history
  man           Show the full manual

Options:
  --help        Show this help
  --version     Show version
EOF
)

[[ "$*" =~ --help ]] && printf "%s\n" "$HELP" && exit 0
[[ "${1:-}" == --version ]] && printf "%s %s\n" "$PROGRAM" "$VERSION" && exit 0

#------------------------------------------------------------------------------
#  CONFIG
#------------------------------------------------------------------------------

LOG="${HOME}/.local/share/public-ip.log"

#------------------------------------------------------------------------------
#  FUNCTIONS
#------------------------------------------------------------------------------

get_public_ip() {
    curl -fsS https://ifconfig.io/ip
}

update_public_ip() {
    mkdir -p "$(dirname "$LOG")"

    local current_ip
    local last_ip

    current_ip="$(get_public_ip)"
    last_ip="$(tail -n 1 "$LOG" 2>/dev/null | awk '{print $2}' || true)"

    if [[ "$current_ip" != "$last_ip" ]]; then
        printf '%s %s\n' \
            "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
            "$current_ip" >> "$LOG"

        printf 'Public IP changed: %s\n' "$current_ip"
    fi
}

show_log() {
    if [[ -f "$LOG" ]]; then
        cat "$LOG"
    else
        printf 'No public IP history yet.\n'
    fi
}

show_man() {
    local man_dir="${HOME}/.local/share/man/man1"
    local man_file="${man_dir}/${PROGRAM}.1"
    local man_url="https://athesto.github.io/scripts/bash/man/${PROGRAM}.1"

    mkdir -p "$man_dir"

    if [[ ! -f "$man_file" ]]; then
        printf 'Downloading manual...\n'
        curl -fsSL "$man_url" -o "$man_file"
    fi

    man "$man_file"
}

#------------------------------------------------------------------------------
#  MAIN / ENTRY POINT
#------------------------------------------------------------------------------

case "${1:-current}" in
    current)
        get_public_ip
        ;;

    update)
        update_public_ip
        ;;

    log)
        show_log
        ;;

    man)
        show_man
        ;;

    *)
        printf 'Unknown command: %s\n' "$1" >&2
        printf 'Try "%s --help" for more information.\n' "$PROGRAM" >&2
        exit 1
        ;;
esac